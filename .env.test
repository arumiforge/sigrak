# Overrides for "node ace test". The test runner migrates and truncates
# this database, so it must never point at the development database.
SESSION_DRIVER=memory
LIMITER_STORE=memory
DB_DATABASE=sigrak_test
# Queues and AI key state in their own test databases; tests flush them.
REDIS_QUEUE_DB=11
REDIS_AI_DB=12
AI_PROVIDER=fake
