@component('public/layout', layout)
  <article class="mx-auto max-w-3xl">
    <h1 class="text-3xl font-bold break-words">{{ title }}</h1>
    @if(document)
      <p class="mt-2 text-muted">{{ document.version }} · {{ document.effective }}</p>
      @if(!document.isCurrent)
        <p class="mt-4 rounded-md border border-warn/35 bg-warn-tint p-3 text-sm text-warn">
          {{ t('publishing.public.legal.not_current') }}
          @if(currentHref)
            <a href="{{ currentHref }}" class="font-semibold underline">
              {{ t('publishing.public.legal.current_link') }}
            </a>
          @end
        </p>
      @end
    @end
    @if(upcoming)
      <p class="mt-4 rounded-md border border-info/30 bg-info-tint p-3 text-sm text-info">
        {{ upcoming.text }}
        <a href="{{ upcoming.href }}" class="font-semibold underline">
          {{ t('publishing.public.legal.upcoming_link') }}
        </a>
      </p>
    @end
    @if(document)
      <div class="rich-text mt-8">{{{ document.html }}}</div>
    @else
      <p class="mt-8 rounded-lg border border-dashed bg-surface p-6 text-muted">
        {{ t('publishing.public.legal.preparing') }}
      </p>
    @end
    @if(versions.length)
      <h2 class="mt-12 text-lg font-bold">{{ t('publishing.public.legal.older') }}</h2>
      <ul class="mt-2 space-y-1">
        @each(version in versions)
          <li>
            <a
              href="{{ version.href }}"
              class="inline-flex min-h-11 items-center font-semibold text-brand-strong hover:underline"
            >
              {{ version.label }}
            </a>
          </li>
        @end
      </ul>
    @end
  </article>
@end
