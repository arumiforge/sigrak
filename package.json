{
  "name": "sigrak",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "start": "node bin/server.js",
    "dev": "node ace serve --hmr",
    "build": "node ace build",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
    "db:migrate": "node ace migration:run",
    "db:seed": "node ace db:seed",
    "db:fresh": "node ace migration:fresh --seed",
    "audit:prod": "pnpm audit --prod --audit-level high"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#jobs/*": "./app/jobs/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#tenancy/*": "./app/tenancy/*.js",
    "#regions/*": "./app/regions/*.js",
    "#accounts/*": "./app/accounts/*.js",
    "#layers/*": "./app/layers/*.js",
    "#school_year/*": "./app/school_year/*.js",
    "#timetable/*": "./app/timetable/*.js",
    "#calendar/*": "./app/calendar/*.js",
    "#staff/*": "./app/staff/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.2",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@babel/core": "^7.29.13",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/babel__core": "^7.20.5",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.2",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/i18n": "^3.0.1",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/limiter": "^3.1.0",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.1",
    "@adonisjs/redis": "^11.0.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.2",
    "@adonisjs/transmit": "^3.0.3",
    "@adonisjs/transmit-client": "^1.1.0",
    "@adonisjs/vite": "^6.0.2",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@inertiajs/core": "^3.7.1",
    "@inertiajs/react": "^3.7.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.28",
    "@vinejs/vine": "^4.4.0",
    "bullmq": "^6.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "otpauth": "9.6.0",
    "pg": "^8.23.1",
    "piscina": "5.3.2",
    "qrcode-generator": "2.0.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "uuid": "^14.0.3",
    "vaul": "1.1.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@swc/core": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config",
  "packageManager": "pnpm@12.23.0"
}
