# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# App
# Generate with: node ace generate:key
APP_KEY=
# Hosts are app.<APP_DOMAIN>, admin.<APP_DOMAIN> and ujian.<APP_DOMAIN>
APP_DOMAIN=sigrak.test
APP_SCHEME=http

# Session (cookie | redis | memory)
SESSION_DRIVER=redis

# Database (compose.yaml)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=sigrak
DB_PASSWORD=sigrak
DB_DATABASE=sigrak

# Redis (compose.yaml)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# BullMQ queues and AI key state use their own databases (D-053)
REDIS_QUEUE_DB=1
REDIS_AI_DB=2

# AI provider: fake (scripted, no key needed) | gemini (teachers' keys)
AI_PROVIDER=fake
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Transmit (server-sent events) between processes: redis | none
TRANSMIT_TRANSPORT=redis

# Rate limiter (redis | memory)
LIMITER_STORE=redis