# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# App
# Generate with: node ace generate:key
APP_KEY=
# Hosts are app.<APP_DOMAIN>, admin.<APP_DOMAIN> and ujian.<APP_DOMAIN>
APP_DOMAIN=sigrak.test
APP_SCHEME=http

# Session (cookie | redis | memory)
SESSION_DRIVER=redis

# Database (compose.yaml)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=sigrak
DB_PASSWORD=sigrak
DB_DATABASE=sigrak
# The app's login user (member of the non-owner role sigrak_app, so
# row-level security applies). Tests create it; servers create it in setup.
DB_APP_USER=sigrak_app_user
DB_APP_PASSWORD=sigrak_app

# Redis (compose.yaml)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# BullMQ queues and AI key state use their own databases (D-053)
REDIS_QUEUE_DB=1
REDIS_AI_DB=2

# Queue workers (D-467). Jobs one worker process runs at the same time;
# out-of-range values are clamped (app/services/queue/settings.ts).
# worker-ai: 1-500, default 50 (two processes in production, so a restart never stops all AI work)
QUEUE_AI_CONCURRENCY=50
# worker-exports: 1-32, default 2 (CPU-heavy work runs in the CPU pool below)
QUEUE_EXPORTS_CONCURRENCY=2
# worker-default: 1-100, default 4
QUEUE_DEFAULT_CONCURRENCY=4
# Log a queue-wait alert when a job waited longer than this before it started (1000-3600000 ms)
QUEUE_WAIT_ALERT_MS=10000
# worker_threads pool on worker-exports (D-463). Leave unset for the container's
# CPU limit minus one (read from cgroup, at least 1); 1-64 when set.
# CPU_POOL_SIZE=

# UV_THREADPOOL_SIZE per process role (D-467, docs/drafts/r0-gate.md section 6).
# Set it in the container environment (deploy compose file), not here: libuv reads
# it from the real process environment when the pool first starts, which can be
# before this file is loaded. Never more than the cores a container may use.
#   web 4 · exam 2 · worker-ai 4 · worker-exports 4 · worker-default 4 · scheduler 2

# AI provider: fake (scripted, no key needed) | gemini (teachers' keys)
AI_PROVIDER=fake
# AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Transmit (server-sent events) between processes: redis | none
TRANSMIT_TRANSPORT=redis

# Rate limiter (redis | memory)
LIMITER_STORE=redis